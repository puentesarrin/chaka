# App identity / routing (all optional).
TITLE=Chaka
WEBSOCKET_PATH=/ws
# Asset dirs default to the copies bundled inside the package. Override to use
# your own — e.g. the ./static and ./templates that `chaka init` writes.
# STATIC_DIR=./static
# TEMPLATES_DIR=./templates

# Database (SQLAlchemy async URL). MySQL (aiomysql) and PostgreSQL (asyncpg)
# are both supported — swap the scheme/driver and DATABASE_URL is all that
# changes. Example below uses MySQL.
DATABASE_URL=mysql+aiomysql://user:pass@localhost:3306/chaka
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/chaka

# Signs the admin session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave it unset and Chaka makes an ephemeral one at startup — everyone is
# signed out on every restart, and multiple workers each sign differently.
SECRET_KEY=

# Bootstrap admin credentials. They log in only while the users table is empty,
# and the first successful login is saved as a real user account; after that,
# manage users on the admin UI's Users tab or with `chaka user`.
# CHANGE THESE before exposing the server.
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Session cookie tuning (all optional).
# SESSION_COOKIE=chaka_session
# SESSION_MAX_AGE=43200
# Send the cookie only over HTTPS. Turn this on once you serve Chaka over TLS.
# SESSION_COOKIE_SECURE=false

# Application log (rotating file handler).
LOG_FILE=./chaka.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# Optional: push heartbeat to a status-page / uptime monitor (Uptime Kuma,
# Healthchecks.io, BetterStack, …). Leave HEARTBEAT_URL blank to disable.
HEARTBEAT_URL=
HEARTBEAT_INTERVAL=60
HEARTBEAT_LOG_FILE=./heartbeat.log

# Optional: Sentry error reporting. Leave SENTRY_DSN blank to disable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
